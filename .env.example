# Multiverse Echoes Client — environment variables.
# Copy this file to .env and adjust values for your environment.

# API base URL the client talks to.
#   - Local development against a self-hosted engine: http://localhost:8080
#   - Hosted Multiverse Echoes API:                   https://api.echolabsme.com
VITE_API_BASE_URL=http://localhost:8080

# Cloudflare Turnstile site key (public — embedded in client HTML).
# The value below is Cloudflare's documented "always passes" testing key,
# safe to use for local development. For production, register your own
# Turnstile widget at https://developers.cloudflare.com/turnstile/.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
