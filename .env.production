# Production build overrides — Vite loads .env.production for `vite build`.
# Split-origin architecture: static client is served from echolabsme.com
# (Cloudflare Pages); the Rust API runs on the B200 behind
# api.echolabsme.com (Cloudflare Tunnel). Client → API is cross-origin,
# so the base URL must be explicit. Do NOT revert to empty unless the
# architecture goes back to same-origin.
VITE_API_BASE_URL=https://api.echolabsme.com
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACxdpvCyr8Nio0QB
