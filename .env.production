# Production build overrides — Vite loads .env.production for `vite build`.
# VITE_API_BASE_URL must be empty so resolveBaseUrl() falls back to
# window.location.origin. The local .env sets it to localhost:8080 for dev;
# if that leaks into a production build, all API calls go to the user's
# own machine and nothing works (login fails, echoes vanish).
VITE_API_BASE_URL=
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACxdpvCyr8Nio0QB
