{
  "name": "multiverse-echoes-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.js && node scripts/generate-choose-language-inline.js",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/prerender.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "generate-types": "cd .. && cargo run --bin generate-types",
    "check-i18n": "node scripts/check-i18n-keys.js",
    "check-strings": "node scripts/check-hardcoded-strings.js",
    "check-dynamic-keys": "node scripts/check-dynamic-keys.js",
    "check-choose-language-inline": "node scripts/generate-choose-language-inline.js --check",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@marsidev/react-turnstile": "^1.5.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "i18next": "^25.0.0",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^0.500.0",
    "opus-recorder": "^8.0.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^2.15.4",
    "three": "^0.183.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.4",
    "eslint-plugin-better-tailwindcss": "^4.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.7",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0",
    "typescript-eslint": "^8.57.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  }
}
